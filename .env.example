# Primary LLM (any OpenAI-compatible endpoint). Example: Gemini free tier
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Cheap model for query expansion / judge
LLM_SMALL_MODEL=gemini-2.5-flash-lite
# Fallback provider (e.g. Groq) used on timeout / 429
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=llama-3.3-70b-versatile
FALLBACK_API_KEY=
# Optional: Qdrant server instead of embedded mode
QDRANT_URL=
